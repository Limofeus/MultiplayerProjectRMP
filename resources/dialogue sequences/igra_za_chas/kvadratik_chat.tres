[sub_resource type="Resource" id="Resource_7vcot"]
script = ExtResource("3_3hmkj")
dialogue_text = "О, привет! Давненько тут никого не было... В любом случае, дальше будет опасьненько, так что тебе лучше выбрать оружие. Можешь взять любое, из карманов..."
sync_dialogue_block = true
metadata/_custom_type_script = "uid://8njgmbn7c7jq"

[sub_resource type="Resource" id="Resource_whaxx"]
script = ExtResource("3_3hmkj")
dialogue_text = "В любом случае оно не моё, а мне платят, только чтобы тут летать и разговаривать с вами. Короче: оружие - ключ к выживанию и всё такое."
sync_dialogue_block = true
