[sub_resource type="Resource" id="Resource_7vcot"]
script = ExtResource("3_6oi47")
dialogue_text = "О, приветсвую! Добро пожаловать на тест мультиплеера! Сразу предупреждаю: нет. Тортов у нас нет, как и злого ИИ, как и порталов, как и... Ну вы поняли. Итак, вам нужно идти вперёд и сражатся! Просто, не так-ли?"
sync_dialogue_block = true
metadata/_custom_type_script = "uid://8njgmbn7c7jq"

[sub_resource type="Resource" id="Resource_50ps0"]
script = ExtResource("4_xm6ww")
useless_choices = Array[String](["да, наверное...", "ага"])
dialogue_text = "Ну что? всё поняли?"
sync_dialogue_block = true
metadata/_custom_type_script = "uid://bew54dp5qxf0f"

[sub_resource type="Resource" id="Resource_di2au"]
script = ExtResource("3_6oi47")
dialogue_text = "Супер! Тогда вперёд! За науку!"
sync_dialogue_block = true
