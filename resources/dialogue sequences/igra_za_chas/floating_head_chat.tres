[sub_resource type="Resource" id="Resource_7vcot"]
script = ExtResource("3_askog")
dialogue_text = "А? хм... О.... Ваушки! Ты меня нашёл, ха! Я знал, что рано или поздно меня кто-нибудь найдёт! "
sync_dialogue_block = true
metadata/_custom_type_script = "uid://8njgmbn7c7jq"

[sub_resource type="Resource" id="Resource_nhyoc"]
script = ExtResource("4_2idc8")
useless_choices = Array[String](["мне лень", "хм, а что ты можешь мне предложить?"])
dialogue_text = "Слушай, в этой комнате немного пустовато. Не мог бы ты сказать тому скелету из рецепшона, чтобы хотя бы телик сюда поставил, ладно? "
sync_dialogue_block = true
metadata/_custom_type_script = "uid://bew54dp5qxf0f"

[sub_resource type="Resource" id="Resource_2tk7a"]
script = ExtResource("3_askog")
dialogue_text = "А я тебе... хм... О... А я тебе выдам бесплатно свою книгу про твои Приключения! Когда я её напишу, конечно."
sync_dialogue_block = true
metadata/_custom_type_script = "uid://8njgmbn7c7jq"

[sub_resource type="Resource" id="Resource_ukgjv"]
script = ExtResource("3_askog")
dialogue_text = "Только сейчас вряд-ли получится обсудить этот вопрос... Но ты не забудь, как появится возможность попросить, ладно?"
sync_dialogue_block = true
metadata/_custom_type_script = "uid://8njgmbn7c7jq"

